{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node D:\\turnstat\\bin\\turnstat.mjs hook",
            "timeout": 10,
            "statusMessage": "turnstat: 사전 판정"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node D:\\turnstat\\bin\\turnstat.mjs stop-hook",
            "timeout": 10,
            "statusMessage": "turnstat: 사용량 집계"
          }
        ]
      }
    ]
  }
}
